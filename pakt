# TODO NOW handle case "pakt i +cat" and "pakt u +cat"
case "$1" in
	install|i)
		shift
		construct_pairs "$@"
		echo "TODO pairs: $pairs"
		cmd="$PACKAGE_MANAGER $INSTALL_ARG $cmd_args"
		$cmd && write_from_pairs

		echo "TODO debug"
		echo "$pairs"
		printf "debug end\n\n"
		;;
	uninstall|u)
		shift
		construct_pairs "$@"
		cmd="$PACKAGE_MANAGER $UNINSTALL_ARG $cmd_args"
		$cmd && delete_from_pairs

		echo "TODO debug"
		echo "$pairs"
		printf "debug end\n\n"
		;;
	dry|d)
		;;
	sync|s)
		;;
	find|f)
		;;
	native|n)
		shift
		$PACKAGE_MANAGER "$@"
		;;
	edit|e)
		;;
	help|h)
		help
		exit
		;;
	*)
		error "$1"
		exit
		;;
esac
