#!/bin/sh
# TODO FINAL COMMENT ALL

set -eu

# TODO FINAL /etc support
: "${PAKT_CONF_PATH:=${XDG_CONFIG_HOME:-$HOME/.config}}"
: "${PAKT_EDITOR:=${EDITOR:-nano}}"
: "${CAT_SYNTAX:="+"}"
: "${NO_ARG_ACTION:="pakt help"}"
: "${PAKT_CAT_PATH:=${XDG_DATA_HOME:-$HOME/.local/share}/pakt}"
mkdir -p "$PAKT_CAT_PATH"

. "$PAKT_CONF_PATH/pakt.conf"

if [ $# -eq 0 ]; then
	$NO_ARG_ACTION
	exit
fi

# TODO write proper help message
help() {
	echo "pakt – a package manager wrapper with category support

Usage:
    pakt
    pakt install
    pakt uninstall
    pakt dry-install
    pakt dry-uninstall
    pakt sync-install
    pakt sync-uninstall
    pakt find
    pakt native
    pakt edit
    pakt help"
}

error() {
	echo "\x1b[31mInvalid subcommand '$1'!
See 'pakt help' for available options!\x1b[39m"
}

construct_pairs() {
	cmd_args=""
	pairs=""
	pkgs=""
	cats=""

	for arg; do
		case "$arg" in
			$CAT_SYNTAX$CAT_SYNTAX)
				cats=$(ls "$PAKT_CAT_PATH")
				;;
			$CAT_SYNTAX*)
				cats="$cats ${arg#?}"
				;;
			-*)
				cmd_args="$cmd_args $arg"
				;;
			*)
				[ -n "$cats" ] && update_pairs
				pkgs="$pkgs $arg"
				cmd_args="$cmd_args $arg"
				;;
		esac
	done
	update_pairs
}

update_pairs() {
	for pkg in "$pkgs"; do
		pairs="$pairs $pkg $cats\n"
	done
	pkgs=""
	cats=""
}

write_from_pairs() {
	printf "$pairs\n" | while IFS= read -r line; do
		[ -z "$line" ] && continue
		set -- $line
		pkg="$1"
		shift
		for cat; do
			file="$PAKT_CAT_PATH/$cat"
			grep -qF "$pkg" "$file" 2>/dev/null || echo "$pkg" >> "$file"
		done
	done
}

delete_from_pairs() {
	printf "$pairs\n" | while IFS= read -r line; do
		[ -z "$line" ] && continue
		set -- $line
		pkg="$1"
		shift
		for cat; do
			file="$PAKT_CAT_PATH/$cat"
			sed -i "/^$pkg$/d" "$file"
		done
	done
}

construct_file_list() {
	files=""
	for arg; do
		case "$arg" in
			$CAT_SYNTAX$CAT_SYNTAX)
				files=$(find "$PAKT_CAT_PATH")
				;;
			$CAT_SYNTAX*)
				files="$files $PAKT_CAT_PATH/${arg#?}"
				;;
			*)
				files="$files $arg"
				;;
		esac
	done
}

# TODO NOTE idea about storing categories
# a grand string with this format:
# "pkg cat
# pkg cat2
# pkg2 cat
# pkg2 cat2"

# TODO NOW handle no args on subcommands
case "$1" in
	install|i)
		shift
		construct_pairs "$@"
		cmd="$PACKAGE_MANAGER $INSTALL_ARG $cmd_args"
		$cmd && write_from_pairs
		;;
	uninstall|u)
		shift
		construct_pairs "$@"
		cmd="$PACKAGE_MANAGER $UNINSTALL_ARG $cmd_args"
		$cmd && delete_from_pairs

		[ $REMOVE_EMPTY_CATS -eq 1 ] && find "$PAKT_CAT_PATH" -empty -delete || true
		;;
	dry-install|di)
		shift
		construct_pairs "$@"
		write_from_pairs
		;;
	dry-uninstall|du)
		shift
		construct_pairs "$@"
		delete_from_pairs

		[ $REMOVE_EMPTY_CATS -eq 1 ] && find "$PAKT_CAT_PATH" -empty -delete || true
		;;
	sync-install|si)
		shift
		construct_file_list
		$PACKAGE_MANAGER $INSTALL_ARG $(grep -rvh "#" $files)
		;;
	sync-uninstall|su)
		shift
		construct_file_list
		$PACKAGE_MANAGER $UNINSTALL_ARG $(grep -rvh "#" $files)
		;;
	find|f)
		# TODO NOW CONSIDER OPTIMIZE
		shift
		for arg; do
			for file in $(grep -rl "$arg" "$PAKT_CAT_PATH"); do
				basename "$file"
			done
		done
		;;
	native|n)
		shift
		$PACKAGE_MANAGER "$@"
		;;
	edit|e)
		;;
	help|h)
		help
		exit
		;;
	*)
		error "$1"
		exit
		;;
esac
