#!/bin/sh

set -eu

: "${PAKT_CONF_PATH:=${XDG_CONFIG_HOME:-$HOME/.config}}"
: "${PAKT_EDITOR:=${EDITOR:-nano}}"

. "$PAKT_CONF_PATH/pakt.conf"

if [ $# -eq 0 ]; then
	"${NO_ARG_ACTION[@]}"
	exit
fi

help() {
	printf "pakt – a package manager wrapper with category support

Usage:
    pakt
    pakt install
    pakt uninstall
    pakt dry
    pakt sync
    pakt find
    pakt nat
    pakt edit
    pakt help\n"
}

error() {
	printf "Invalid subcommand '$1'!\nSee 'pakt help' for available options!\n"
}

case "$1" in
	"install"|"i")
		;;
	"uninstall"|"u")
		;;
	"dry"|"d")
		;;
	"sync"|"s")
		;;
	"find"|"f")
		;;
	"nat"|"n")
		shift
		"$PACKAGE_MANAGER" "$@"
		;;
	"edit"|"e")
		;;
	"help"|"h")
		help
		exit
		;;
	*)
		error "$1"
		exit
		;;
esac
